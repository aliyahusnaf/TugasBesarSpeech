item []:
    item [1]:
        class = "IntervalTier"
        name = "utterance"
        xmin = 0
        xmax = 305.000
        intervals: size = 107
        intervals [1]:
            xmin = 0.000
            xmax = 0.060
            text = ""
        intervals [2]:
            xmin = 0.060
            xmax = 9.040
            text = "sekarang terakhir ini aku nak cerito tentang makanan favorit aku sebenernya ado banyak yang paling aku suko tapi kalo harus milih ada tigo makanan yang pengen aku ceritoke"
        intervals [3]:
            xmin = 9.040
            xmax = 9.960
            text = ""
        intervals [4]:
            xmin = 9.960
            xmax = 11.000
            text = "yang pertamo rendang"
        intervals [5]:
            xmin = 11.000
            xmax = 12.160
            text = ""
        intervals [6]:
            xmin = 12.160
            xmax = 15.340
            text = "terus ada soto betawi samo ada es krim durian"
        intervals [7]:
            xmin = 15.340
            xmax = 16.620
            text = ""
        intervals [8]:
            xmin = 16.620
            xmax = 27.820
            text = "pertamo rendang jujur bae siapa sih yang dak suko rendang menurut aku rendang ni salah satu makanan paling enak yang ada di indonesia aku tu kalu makan nasi padang rasonyo harus ada rendangnyo kalo udah ado rendang"
        intervals [9]:
            xmin = 27.820
            xmax = 28.760
            text = ""
        intervals [10]:
            xmin = 28.760
            xmax = 30.040
            text = "cak ado yang kurang be lah"
        intervals [11]:
            xmin = 30.040
            xmax = 30.700
            text = ""
        intervals [12]:
            xmin = 30.700
            xmax = 41.480
            text = "bukan berarti lauk padang yang lain dak enak tapi menurut aku rendang ni memang punya tempat khusus nah yang bikin aku suko rendang tentu bae bumbunyo menurut aku rendang yang enak tu bumbunyo harus kuat dan meresap sampe ke dalam daging"
        intervals [13]:
            xmin = 41.480
            xmax = 43.090
            text = ""
        intervals [14]:
            xmin = 43.090
            xmax = 51.830
            text = "tapi sebenernya ado duo tipe rendang yang aku suko yang pertamo rendang yang dagingnya lembut nian jadi pas dimakan dagingnyo gampang dipotong dan dikunyah"
        intervals [15]:
            xmin = 51.830
            xmax = 52.470
            text = ""
        intervals [16]:
            xmin = 52.470
            xmax = 55.390
            text = "apalagi kalu bumbunyo banyak dan meresap wah itu enak nian"
        intervals [17]:
            xmin = 55.390
            xmax = 56.050
            text = ""
        intervals [18]:
            xmin = 56.050
            xmax = 63.090
            text = "terus kalu kedua itu rendang yang dimasak lamo nian sampai warnanyo gelap hampir hitam dan teksturnyo jadi agak kering"
        intervals [19]:
            xmin = 63.090
            xmax = 64.070
            text = ""
        intervals [20]:
            xmin = 64.070
            xmax = 72.410
            text = "nah ini juga aku suko nian walaupun biasanyo dagingnyo jadi sedikit keras menurut aku justru rasonyo lebih pekat bumbunya cak la bener-bener menyatu samo dagingnyo"
        intervals [21]:
            xmin = 72.410
            xmax = 73.310
            text = ""
        intervals [22]:
            xmin = 73.310
            xmax = 78.830
            text = "jadi aku suko duo-duonyo entah rendang yang lembut atau rendang yang kering dan gelap kalu bumbunya pas menurut aku pasti enak"
        intervals [23]:
            xmin = 78.830
            xmax = 79.490
            text = ""
        intervals [24]:
            xmin = 79.490
            xmax = 80.790
            text = "pokoknyo kalo ada rendang"
        intervals [25]:
            xmin = 80.790
            xmax = 81.690
            text = ""
        intervals [26]:
            xmin = 81.690
            xmax = 85.530
            text = "apalagi dimakan samo nasi anget itulah cukup nian buat aku lah"
        intervals [27]:
            xmin = 85.530
            xmax = 86.790
            text = ""
        intervals [28]:
            xmin = 86.790
            xmax = 88.810
            text = "nah makanan kedua itu soto betawi"
        intervals [29]:
            xmin = 88.810
            xmax = 89.410
            text = ""
        intervals [30]:
            xmin = 89.410
            xmax = 93.170
            text = "menurut aku dari sekian banyak jenis soto yang pernah aku makan soto betawi ini yang paling enak"
        intervals [31]:
            xmin = 93.170
            xmax = 93.810
            text = ""
        intervals [32]:
            xmin = 93.810
            xmax = 98.950
            text = "padahal kan di indonesia banyak jenis soto ado soto ayam soto lamongan soto bandung samo yang lainnyo"
        intervals [33]:
            xmin = 98.950
            xmax = 99.670
            text = ""
        intervals [34]:
            xmin = 99.670
            xmax = 108.270
            text = "tapi kalu aku disuruh milih jawabannya tetep soto betawi alasan utamonyo tu karna kuahnyo aku suko nian soto betawi yang kuahnyo pake santan"
        intervals [35]:
            xmin = 108.270
            xmax = 109.130
            text = ""
        intervals [36]:
            xmin = 109.130
            xmax = 113.030
            text = "soalnyo kuahnyo jadi gurih kental dan rasonyo medok nian"
        intervals [37]:
            xmin = 113.030
            xmax = 114.070
            text = ""
        intervals [38]:
            xmin = 114.070
            xmax = 117.810
            text = "terus kalu dipaduke samo daging sapi yang lembut wah itu enak nian lah"
        intervals [39]:
            xmin = 117.810
            xmax = 118.410
            text = ""
        intervals [40]:
            xmin = 118.410
            xmax = 124.530
            text = "menurut aku perpaduan antara kuah yang gurih bumbu yang kuat samo daging empuk tu yang bikin soto betawi istimewa"
        intervals [41]:
            xmin = 124.530
            xmax = 125.070
            text = ""
        intervals [42]:
            xmin = 125.070
            xmax = 131.150
            text = "nah di bandung deket kampusku ado tempat makan soto betawi yang sering aku datengi tempatnyo ada di jalan gelap nyawang"
        intervals [43]:
            xmin = 131.150
            xmax = 131.840
            text = ""
        intervals [44]:
            xmin = 131.840
            xmax = 139.020
            text = "menurut aku soto betawi di situ enak nian kuahnya pas sama selero aku gurihnya dapet dan secara keseluruhan memang cocok samo lidah aku"
        intervals [45]:
            xmin = 139.020
            xmax = 139.920
            text = ""
        intervals [46]:
            xmin = 139.920
            xmax = 150.880
            text = "jadi kalu lagi di kampus terus pengen makan soto betawi tempat itu sering jadi bikin lahan aku apalagi di bandung ni cuacanyo kadang dingin jadi makan soto yang kuahnyo anget dan gurih cak itu rasonyo makin enak"
        intervals [47]:
            xmin = 150.880
            xmax = 151.740
            text = ""
        intervals [48]:
            xmin = 151.740
            xmax = 153.080
            text = "pokoknya kalu ngomongin soto favorit"
        intervals [49]:
            xmin = 153.080
            xmax = 154.020
            text = ""
        intervals [50]:
            xmin = 154.020
            xmax = 157.160
            text = "soto betawi masih jadi nomor satu buat aku lah"
        intervals [51]:
            xmin = 157.160
            xmax = 158.160
            text = ""
        intervals [52]:
            xmin = 158.160
            xmax = 160.520
            text = "nah makanan ketigo ni agak berbeda"
        intervals [53]:
            xmin = 160.520
            xmax = 161.080
            text = ""
        intervals [54]:
            xmin = 161.080
            xmax = 166.160
            text = "karno sekarang aku nak ngomongin makanan manis yaitu es krim durian aku ni memang suko nian samo durian"
        intervals [55]:
            xmin = 166.160
            xmax = 166.880
            text = ""
        intervals [56]:
            xmin = 166.880
            xmax = 172.440
            text = "aku tau ado wong yang dak tahan sama bau durian bahkan ado yang dak suko sama rasonyo"
        intervals [57]:
            xmin = 172.440
            xmax = 173.100
            text = ""
        intervals [58]:
            xmin = 173.100
            xmax = 174.380
            text = "tapi kalu aku justru suko nian"
        intervals [59]:
            xmin = 174.380
            xmax = 175.200
            text = ""
        intervals [60]:
            xmin = 175.200
            xmax = 183.160
            text = "menurut aku durian tu punyo raso yang khas teksturnya lembut dan aromanyo kuat nah kalau durian bae la enak apalagi kalau dijadike es krim"
        intervals [61]:
            xmin = 183.160
            xmax = 183.820
            text = ""
        intervals [62]:
            xmin = 183.820
            xmax = 193.660
            text = "di deket rumah aku di bekasi ada tempat jual es krim durian yang namonyo es krim durian mas cahyo nah ini salah satu es krim favorit aku dari jaman sd sampe la sekarang aku kuliah"
        intervals [63]:
            xmin = 193.660
            xmax = 194.660
            text = ""
        intervals [64]:
            xmin = 194.660
            xmax = 206.160
            text = "jadi biso dibayangke lah berapo lamo aku suko sama es krim ini dari masih kecik sampe sekarang umur dua puluh satu tahun aku masih inget dan masih suko sama rasonyo"
        intervals [65]:
            xmin = 206.160
            xmax = 206.980
            text = ""
        intervals [66]:
            xmin = 206.980
            xmax = 208.120
            text = "tapi ado satu hal yang menarik"
        intervals [67]:
            xmin = 208.120
            xmax = 208.720
            text = ""
        intervals [68]:
            xmin = 208.720
            xmax = 209.660
            text = "menurut aku"
        intervals [69]:
            xmin = 209.660
            xmax = 210.240
            text = ""
        intervals [70]:
            xmin = 210.240
            xmax = 212.580
            text = "raso es krim durian masa ini sekarang dala"
        intervals [71]:
            xmin = 212.580
            xmax = 213.380
            text = ""
        intervals [72]:
            xmin = 213.380
            xmax = 215.680
            text = "daksa enak waktu aku masih sd dulu lah"
        intervals [73]:
            xmin = 215.680
            xmax = 216.620
            text = ""
        intervals [74]:
            xmin = 216.620
            xmax = 220.620
            text = "aku dak tau apakah memang ado yang berubah dari es krimnyo atau mungkin selera aku dewek yang"
        intervals [75]:
            xmin = 220.620
            xmax = 221.200
            text = ""
        intervals [76]:
            xmin = 221.200
            xmax = 221.740
            text = "la berubah"
        intervals [77]:
            xmin = 221.740
            xmax = 222.920
            text = ""
        intervals [78]:
            xmin = 222.920
            xmax = 227.720
            text = "biso jugo karna pas aku masih kecik dulu makan es krim itu rasonya lebih spesial dibanding sekarang"
        intervals [79]:
            xmin = 227.720
            xmax = 228.340
            text = ""
        intervals [80]:
            xmin = 228.340
            xmax = 229.500
            text = "tapi walaupun begitu"
        intervals [81]:
            xmin = 229.500
            xmax = 230.160
            text = ""
        intervals [82]:
            xmin = 230.160
            xmax = 234.660
            text = "sampai sekarang es krim durian mas cahyo ni masih jadi es krim durian paling enak yang pernah aku cuba"
        intervals [83]:
            xmin = 234.660
            xmax = 235.200
            text = ""
        intervals [84]:
            xmin = 235.200
            xmax = 240.840
            text = "jadi walaupun menurut aku rasonyo sekarang dak semantap dulu tetep bae belum ado yang biso ngalahke"
        intervals [85]:
            xmin = 240.840
            xmax = 241.740
            text = ""
        intervals [86]:
            xmin = 241.740
            xmax = 242.620
            text = "menurut aku ni"
        intervals [87]:
            xmin = 242.620
            xmax = 243.380
            text = ""
        intervals [88]:
            xmin = 243.380
            xmax = 251.460
            text = "juga salah satu contoh kalu makanan tu bukan cuma masalah raso tapi kadang ado kenangan yang bikin makanan tu jadi lebih spesial"
        intervals [89]:
            xmin = 251.460
            xmax = 252.160
            text = ""
        intervals [90]:
            xmin = 252.160
            xmax = 262.980
            text = "nah selain makanan favorit tadi ada satu hal lagi tentang selera makan aku aku ni sebenernyo dak terlalu suko sayur bukan berarti aku dak makan sayur sama sekali tapi memang sayur yang aku suko dak terlalu banyak"
        intervals [91]:
            xmin = 262.980
            xmax = 263.700
            text = ""
        intervals [92]:
            xmin = 263.700
            xmax = 266.880
            text = "biasanyo aku lebih suka sayur yang kuahnya bening cak sop"
        intervals [93]:
            xmin = 266.880
            xmax = 267.380
            text = ""
        intervals [94]:
            xmin = 267.380
            xmax = 270.440
            text = "atau sayur bayam menurut aku sayur cak itu"
        intervals [95]:
            xmin = 270.440
            xmax = 271.180
            text = ""
        intervals [96]:
            xmin = 271.180
            xmax = 274.440
            text = "lebih cocok samo lidahku karno rasonyo ringan"
        intervals [97]:
            xmin = 274.440
            xmax = 275.340
            text = ""
        intervals [98]:
            xmin = 275.340
            xmax = 281.860
            text = "terus aku juga paling suko tauge sama daun singkong apalagi daun singkong kalu dimakan bareng nasi padang wah cocok nian tu"
        intervals [99]:
            xmin = 281.860
            xmax = 283.000
            text = ""
        intervals [100]:
            xmin = 283.000
            xmax = 287.220
            text = "tapi kalo kangkung sama sayur asem aku memang dak terlalu suko entah mengapo"
        intervals [101]:
            xmin = 287.220
            xmax = 287.940
            text = ""
        intervals [102]:
            xmin = 287.940
            xmax = 295.780
            text = "rasonyo kurang cocok bae samo lidahku jadi kalu ditanyo makanan favorit aku lebih gampang nyebutke lauk daripada sayuran walaupun begitu"
        intervals [103]:
            xmin = 295.780
            xmax = 296.360
            text = ""
        intervals [104]:
            xmin = 296.360
            xmax = 301.340
            text = "aku sadar jugo kalu makan sayur tu penting buat kesehatan jadi memang harus lebih banyak makan sayur"
        intervals [105]:
            xmin = 301.340
            xmax = 304.350
            text = ""
        intervals [106]:
            xmin = 304.350
            xmax = 304.990
            text = "nah jadi itu"
        intervals [107]:
