            text = "es"
        intervals [181]:
            xmin = 475.410
            xmax = 476.690
            text = ""
        intervals [182]:
            xmin = 476.690
            xmax = 481.410
            text = "yang dicampur-campur dengan cak susu es serut susu sirup"
        intervals [183]:
            xmin = 481.410
            xmax = 482.690
            text = ""
        intervals [184]:
            xmin = 482.690
            xmax = 490.310
            text = "terus bisa campur dengan kacang merah juga tapi aku dak gitu suka sih kacang merah jadi makanyo biasanyo aku tu pesen"
        intervals [185]:
            xmin = 490.310
            xmax = 491.130
            text = ""
        intervals [186]:
            xmin = 491.130
            xmax = 496.390
            text = "pake nangko dan tu pake alpukat terus ado jugo yang namanyo roti"
        intervals [187]:
            xmin = 496.390
            xmax = 497.150
            text = ""
        intervals [188]:
            xmin = 497.150
            xmax = 498.910
            text = "itu lemak nian jujur"
        intervals [189]:
            xmin = 498.910
            xmax = 499.450
            text = ""
        intervals [190]:
            xmin = 499.450
            xmax = 499.690
            text = "cak"
        intervals [191]:
            xmin = 499.690
            xmax = 500.510
            text = ""
        intervals [192]:
            xmin = 500.510
            xmax = 507.310
            text = "kayak kau tu ya di palembang tu cak panas nian terus kadang-kadang kau tu pengennya manis terus kau pengen nongkrong beham kawan-kawan kau"
        intervals [193]:
            xmin = 507.310
            xmax = 507.870
            text = ""
        intervals [194]:
            xmin = 507.870
            xmax = 510.650
            text = "jadi kau pergilah ke es koboy ini"
        intervals [195]:
            xmin = 510.650
            xmax = 511.410
            text = ""
        intervals [196]:
            xmin = 511.410
            xmax = 515.210
            text = "terus aku pesen lah sikok dak tu bagi dua dak tu"
        intervals [197]:
            xmin = 515.210
            xmax = 516.010
            text = ""
        intervals [198]:
            xmin = 516.010
            xmax = 518.370
            text = "sikok dewean jugo jujur biso abis sih"
        intervals [199]:
            xmin = 518.370
            xmax = 519.590
            text = ""
        intervals [200]:
            xmin = 519.590
            xmax = 523.650
            text = "nah jadi itulah sepuluh makanan favorit aku"
        intervals [201]:
            xmin = 523.650
            xmax = 524.370
            text = ""
        intervals [202]:
            xmin = 524.370
            xmax = 531.710
            text = "jadi dari sepuluh makanan tadi ado makanan indo ado makanan cina terus ado jugo makanan jepang"
        intervals [203]:
            xmin = 531.710
            xmax = 532.870
            text = ""
        intervals [204]:
            xmin = 532.870
            xmax = 539.350
            text = "tapi kalo diperhati ke banyak makanan favorit aku tu berasal dari palembang karena dari kecik yo"
        intervals [205]:
            xmin = 539.350
            xmax = 540.010
            text = ""
        intervals [206]:
            xmin = 540.010
            xmax = 542.130
            text = "aku la terbiaso makanan-makanan itu"
        intervals [207]:
            xmin = 542.130
            xmax = 542.730
            text = ""
        intervals [208]:
            xmin = 542.730
            xmax = 546.950
            text = "yo walaupun awalnyo tu aku dak gitu suka lah mau pempek"
        intervals [209]:
            xmin = 546.950
            xmax = 548.210
            text = ""
        intervals [210]:
            xmin = 548.210
            xmax = 552.690
            text = "cak aneh juga sih kenapa obisa wong palembang tu dak suka pempek tapi lama-lamo yo"
        intervals [211]:
            xmin = 552.690
            xmax = 553.550
            text = ""
        intervals [212]:
            xmin = 553.550
            xmax = 555.210
            text = "cak aku cobo-cobo terus cak"
        intervals [213]:
            xmin = 555.210
            xmax = 556.470
            text = ""
        intervals [214]:
            xmin = 556.470
            xmax = 558.310
            text = "ternyata lemak juga ya pempek ni"
        intervals [215]:
            xmin = 558.310
            xmax = 559.530
            text = ""
        intervals [216]:
            xmin = 559.530
            xmax = 561.210
            text = "pokoknya jadi cinto mati lah"
        intervals [217]:
            xmin = 561.210
            xmax = 565.590
            text = ""
        intervals [218]:
            xmin = 565.590
            xmax = 571.910
            text = "menurut aku makanan tu bukan cuma soal raso tapi juga bisa nginget ke sama keluargo"
        intervals [219]:
            xmin = 571.910
            xmax = 572.530
            text = ""
        intervals [220]:
            xmin = 572.530
            xmax = 576.270
            text = "sama rumah samo juga pengalaman tertentu terus juga kan"
        intervals [221]:
            xmin = 576.270
            xmax = 577.210
            text = ""
        intervals [222]:
            xmin = 577.210
            xmax = 582.610
            text = "kayak kau mencoba banyak makanan baru sama kawan-kawan kau itu juga bisa bikin kau happy"
        intervals [223]:
            xmin = 582.610
            xmax = 583.202
            text = ""
