        intervals [2]:
            xmin = 0.295
            xmax = 2.455
            text = "pertamo aku nak cerito tentang kuliah aku dulu"
        intervals [3]:
            xmin = 2.455
            xmax = 3.015
            text = ""
        intervals [4]:
            xmin = 3.015
            xmax = 7.175
            text = "jadi kalu ditanyo ngapo aku dulu pengen masuk itb sebenernyo"
        intervals [5]:
            xmin = 7.175
            xmax = 7.855
            text = ""
        intervals [6]:
            xmin = 7.855
            xmax = 9.255
            text = "alasan aku cukup sederhana"
        intervals [7]:
            xmin = 9.255
            xmax = 9.855
            text = ""
        intervals [8]:
            xmin = 9.855
            xmax = 18.275
            text = "menurut aku waktu tu itb ni salah satu institut teknologi terbaik di indonesia apolagi untuk jurusan teknik informatika aku ngeraso itb ni termasuk yang paling bagus"
        intervals [9]:
            xmin = 18.275
            xmax = 18.855
            text = ""
        intervals [10]:
            xmin = 18.855
            xmax = 19.635
            text = "jadi aku mikir"
        intervals [11]:
            xmin = 19.635
            xmax = 20.155
            text = ""
        intervals [12]:
            xmin = 20.155
            xmax = 23.875
            text = "kalu memang ado kesempatan buat kuliah di kampus yang bagus ngapo dak dicubo"
        intervals [13]:
            xmin = 23.875
            xmax = 24.855
            text = ""
        intervals [14]:
            xmin = 24.855
            xmax = 28.255
            text = "selain tu aku juga tertarik karna itb ado di bandung"
        intervals [15]:
            xmin = 28.255
            xmax = 28.755
            text = ""
        intervals [16]:
            xmin = 28.755
            xmax = 34.795
            text = "aku kan asalnyo dari bekasi dan kalu kalian tau bekasi pasti tau jugo gimana panasnyo di sano"
        intervals [17]:
            xmin = 34.795
            xmax = 35.355
            text = ""
        intervals [18]:
            xmin = 35.355
            xmax = 40.435
            text = "nah bandung ni menurut aku lebih nyaman cuacanya lebih adem dan banyak tempat menarik yang biso dikunjungi"
        intervals [19]:
            xmin = 40.435
            xmax = 40.995
            text = ""
        intervals [20]:
            xmin = 40.995
            xmax = 43.435
            text = "jadi itu juga salah satu alasan aku pengen kuliah di sini lah"
        intervals [21]:
            xmin = 43.435
            xmax = 44.395
            text = ""
        intervals [22]:
            xmin = 44.395
            xmax = 58.975
            text = "terus kalu ngomongin ngapo aku milih teknik informatika sebenernyo aku dak punyo alasan yang terlalu spesial bukan karno aku dari kecik aku la jago ngoding lah atau la aku sering bikin program justru aku baru belajar ngoding pas masuk kuliah alasan pertamonyo"
        intervals [23]:
            xmin = 58.975
            xmax = 59.495
            text = ""
        intervals [24]:
            xmin = 59.495
            xmax = 63.455
            text = "aku memang pengen punyo pekerjaan yang kebanyakan dilakuin di dalam ruangan"
        intervals [25]:
            xmin = 63.455
            xmax = 63.995
            text = ""
        intervals [26]:
            xmin = 63.995
            xmax = 70.795
            text = "aku lebih suko pekerjaan yang dak terlalu banyak aktivitas fisik di luar jadi menurut aku informatika lebih cocok nian samo yang aku cari"
        intervals [27]:
            xmin = 70.795
            xmax = 71.375
            text = ""
        intervals [28]:
            xmin = 71.375
            xmax = 79.455
            text = "alasan keduonyo karna aku ngelihat teknologi di dunia sekarang ini makin serba digital hampir galo bidang sekarang membutuhkan teknologi"
        intervals [29]:
            xmin = 79.455
            xmax = 79.955
            text = ""
        intervals [30]:
            xmin = 79.955
            xmax = 86.315
            text = "mulai dari komunikasi keuangan transportasi sampai belanja pun sekarang la banyak yang dilakukan secara online"
        intervals [31]:
            xmin = 86.315
            xmax = 86.890
            text = ""
        intervals [32]:
            xmin = 86.890
            xmax = 90.870
            text = "jadi aku mikir prospek pekerjaan di bidang informatika ini bakal cukup luas"
        intervals [33]:
            xmin = 90.870
            xmax = 91.470
            text = ""
        intervals [34]:
            xmin = 91.470
            xmax = 97.550
            text = "nah kalu misalnyo aku dak masuk teknik informatika sebenernyo ada tigo jurusan lain yang mungkin bakal aku pilih"
        intervals [35]:
            xmin = 97.550
            xmax = 98.590
            text = ""
        intervals [36]:
            xmin = 98.590
            xmax = 100.170
            text = "yang pertamo itu teknik industri"
        intervals [37]:
            xmin = 100.170
            xmax = 100.670
            text = ""
        intervals [38]:
            xmin = 100.670
            xmax = 107.050
            text = "menurut aku jurusan ini menarik karno bidangnyo cukup luas dan lulusannyo bisa kerja di berbagai industri lah"
        intervals [39]:
            xmin = 107.050
            xmax = 107.630
            text = ""
        intervals [40]:
            xmin = 107.630
            xmax = 111.710
            text = "jadi kelihatannyo pilihan pekerjaan setelah lulus pun jugo"
        intervals [41]:
            xmin = 111.710
            xmax = 112.510
            text = ""
        intervals [42]:
            xmin = 112.510
            xmax = 113.030
            text = "lumayan banyak"
        intervals [43]:
            xmin = 113.030
            xmax = 113.930
            text = ""
        intervals [44]:
            xmin = 113.930
            xmax = 116.970
            text = "terus yang kedua ni teknik sipil kalu ini alasannyo sederhana bae"
        intervals [45]:
            xmin = 116.970
            xmax = 117.510
            text = ""
        intervals [46]:
            xmin = 117.510
            xmax = 122.770
            text = "aku memang suko melihat bidangnyo menurut aku menarik gimano sebuah bangunan atau infrastruktur biso"
        intervals [47]:
            xmin = 122.770
            xmax = 123.330
            text = ""
        intervals [48]:
            xmin = 123.330
            xmax = 124.170
            text = "direncanake"
        intervals [49]:
            xmin = 124.170
            xmax = 124.670
            text = ""
        intervals [50]:
            xmin = 124.670
            xmax = 128.170
            text = "dan dibangun sampe akhirnyo jadi sesuatu yang biso dipake wong banyak"
        intervals [51]:
            xmin = 128.170
            xmax = 128.870
            text = ""
        intervals [52]:
            xmin = 128.870
            xmax = 137.890
            text = "nah yang ketigo itu manajemen atau bisnis jujur bae salah satu alasannyo karna dulu aku sering denger kalau jurusan ini relatif lebih gampang dibanding jurusan teknik"
        intervals [53]:
            xmin = 137.890
            xmax = 138.430
            text = ""
        intervals [54]:
            xmin = 138.430
            xmax = 142.990
            text = "tapi itu kan cuma pandangan dari luar aku yakin kalu beneran kuliah di situ pasti ado susahnyo jugo lah"
        intervals [55]:
            xmin = 142.990
            xmax = 143.750
            text = ""
        intervals [56]:
            xmin = 143.750
            xmax = 147.230
            text = "tapi akhirnyo aku masuk teknik informatika itb dan sekarang la semester tujuh"
        intervals [57]:
            xmin = 147.230
            xmax = 147.830
            text = ""
        intervals [58]:
            xmin = 147.830
            xmax = 156.590
            text = "kalau ditanyo apa harapan aku dulu sebenernyo aku cuma pengen bisa belajar lebih jauh tentang teknologi dan hal-hal yang mungkin dak bakal bisa aku dapet kalau aku dak kuliah"
        intervals [59]:
            xmin = 156.590
            xmax = 157.530
            text = ""
        intervals [60]:
            xmin = 157.530
            xmax = 163.570
            text = "aku pengen dak cuma biso pake teknologi tapi jugo ngerti gimano teknologi tu bekerja dan gimano caro membuatnyo"
        intervals [61]:
            xmin = 163.570
            xmax = 164.410
            text = ""
        intervals [62]:
            xmin = 164.410
            xmax = 167.250
            text = "dan sejauh ini menurut aku pengalaman kuliah di sini bagus nian"
        intervals [63]:
            xmin = 167.250
            xmax = 168.630
            text = ""
        intervals [64]:
            xmin = 168.630
            xmax = 176.410
            text = "dari yang aku tau dan dibandingke sama beberapa kampus lain aku ngeraso sistem pembelajaran dan materi di informatika itb ni cukup bagus"
        intervals [65]:
            xmin = 176.410
            xmax = 177.340
            text = ""
        intervals [66]:
            xmin = 177.340
            xmax = 181.560
            text = "salah satu hal yang paling aku suko tu karno banyak tugas besar atau tubes"
        intervals [67]:
