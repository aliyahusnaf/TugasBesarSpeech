            text = ""
        intervals [70]:
            xmin = 185.580
            xmax = 192.480
            text = "belum selesai tu tugas muncul tugas lain kadang tenggat waktunya juga berdekatan jadi harus pinter-pinter ngatur waktu"
        intervals [71]:
            xmin = 192.480
