            text = ""
        intervals [72]:
            xmin = 193.180
            xmax = 201.520
            text = "tapi justru dari tugas-tugas itu aku ngeraso banyak belajar soalnyo kito dak cuma belajar teori di kelas tapi langsung disuruh bikin project"
        intervals [73]:
