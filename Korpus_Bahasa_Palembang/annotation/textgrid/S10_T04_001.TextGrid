        intervals [2]:
            xmin = 0.655
            xmax = 5.395
            text = "terakhir nih kita masuk lah ke bagian yang mungkin paling enak untuk dibahas yaitu makanan"
        intervals [3]:
            xmin = 5.395
            xmax = 5.935
            text = ""
        intervals [4]:
            xmin = 5.935
            xmax = 11.095
            text = "aku nak cerito soal sepuluh makanan yang menurut aku tuh menarik untuk dibahas beberapa merupakan"
        intervals [5]:
            xmin = 11.095
            xmax = 11.735
            text = ""
        intervals [6]:
            xmin = 11.735
            xmax = 14.795
            text = "makanan khas palembang dan ado juga makanan yang banyak dikenal di indonesia"
        intervals [7]:
            xmin = 14.795
            xmax = 15.435
            text = ""
        intervals [8]:
            xmin = 15.435
            xmax = 16.355
            text = "pertamo pempek"
        intervals [9]:
            xmin = 16.355
            xmax = 16.955
            text = ""
        intervals [10]:
            xmin = 16.955
            xmax = 17.975
            text = "kalo ngomongin pempek"
        intervals [11]:
            xmin = 17.975
            xmax = 18.675
            text = ""
        intervals [12]:
            xmin = 18.675
            xmax = 23.035
            text = "yang langsung terbanyang itu tentu bae adonan ikan samo tepung yang dimakan bareng cuko"
        intervals [13]:
            xmin = 23.035
            xmax = 23.615
            text = ""
        intervals [14]:
            xmin = 23.615
            xmax = 30.895
            text = "menurut aku yang bikin pempek menarik tu perpaduan raso gurih dari ikan dengan cuko yang asam manis dan juga pedas apolagi kalo cukonya pas"
        intervals [15]:
            xmin = 30.895
            xmax = 31.495
            text = ""
        intervals [16]:
            xmin = 31.495
            xmax = 32.195
            text = "keduo tekwan"
        intervals [17]:
            xmin = 32.195
            xmax = 32.835
            text = ""
        intervals [18]:
            xmin = 32.835
            xmax = 37.335
            text = "tekwan ni makanan berkuah yang biasanya berisi bola-bola ikan bihun dan juga jamur kuping"
        intervals [19]:
            xmin = 37.335
            xmax = 38.115
            text = ""
        intervals [20]:
            xmin = 38.115
            xmax = 47.515
            text = "ketigo model model ini sekilas mungkin mirip samo tekwan tapi ado bedonyo model ini biasanya bisa berisi tahu yang dibungkus adonan ikan"
        intervals [21]:
            xmin = 47.515
            xmax = 48.375
            text = ""
        intervals [22]:
            xmin = 48.375
            xmax = 57.495
            text = "keempat pindang patin pindang patin ni salah satu makanan khas palembang yang menarik karno kuahnyo tuh punya perpaduan rasa gurih asam dan juga pedas"
        intervals [23]:
            xmin = 57.495
            xmax = 58.795
            text = ""
        intervals [24]:
            xmin = 58.795
            xmax = 58.955
            text = "nah"
        intervals [25]:
            xmin = 58.955
            xmax = 59.615
            text = ""
        intervals [26]:
            xmin = 59.615
            xmax = 62.915
            text = "yang terakhir tuh makanan kesukaanku adalah ayam geprek"
        intervals [27]:
            xmin = 62.915
            xmax = 64.015
            text = ""
        intervals [28]:
            xmin = 64.015
            xmax = 68.775
            text = "aku tuh pilih ayam geprek karena makanan itu mungkin dak seunik makanan khas palembang tadi tapi"
