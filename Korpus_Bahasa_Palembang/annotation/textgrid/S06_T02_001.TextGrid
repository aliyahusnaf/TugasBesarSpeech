            xmin = 507.570
            xmax = 509.270
            text = ""
        intervals [178]:
            xmin = 509.270
            xmax = 513.710
            text = "terus karno hampir galo-galo tugas ni bentuknyo project kelompokan"
        intervals [179]:
            xmin = 513.710
            xmax = 514.395
            text = ""
        intervals [180]:
            xmin = 514.395
            xmax = 518.595
            text = "kami jadi terbiaso dan dilatih nian caronyo bekerjo samo"
        intervals [181]:
            xmin = 518.595
            xmax = 519.295
            text = ""
        intervals [182]:
            xmin = 519.295
            xmax = 526.375
            text = "menekan ego masing-masing kompromi dan cara ngomong yang baik antar tim biar proyek bisa selesai tepat waktu"
        intervals [183]:
            xmin = 526.375
            xmax = 528.235
            text = ""
        intervals [184]:
            xmin = 528.235
            xmax = 532.575
            text = "dan yang paling aku syukuri pulo selama merantau dan kuliah di bandung ni"
        intervals [185]:
            xmin = 532.575
            xmax = 533.315
            text = ""
        intervals [186]:
            xmin = 533.315
            xmax = 538.795
            text = "di jurusan ini aku pacak ketemu kawan-kawan yang sejalan nian solid dan dak pelit ilmu"
        intervals [187]:
            xmin = 538.795
            xmax = 539.355
            text = ""
        intervals [188]:
            xmin = 539.355
            xmax = 541.575
            text = "terus juga saling dukung habis-habisan"
        intervals [189]:
            xmin = 541.575
            xmax = 542.275
            text = ""
        intervals [190]:
            xmin = 542.275
            xmax = 547.135
            text = "jadi pas lagi pusing-pusingnyo ngerjoke tugas berat atau pas lagi begadang ngejar deadline"
        intervals [191]:
            xmin = 547.135
            xmax = 547.735
            text = ""
        intervals [192]:
            xmin = 547.735
            xmax = 556.375
            text = "karno adonyo mereka beban kuliah yang berat tu teraso lebih ringan dan pacak dijalani sambil ketawa-tawa sambil makan mi instan bareng"
        intervals [193]:
            xmin = 556.375
            xmax = 557.555
            text = ""
        intervals [194]:
            xmin = 557.555
            xmax = 561.615
            text = "dan dari galo-galo cerita aku tadi yang paling penting adalah"
        intervals [195]:
            xmin = 561.615
            xmax = 562.135
            text = ""
        intervals [196]:
            xmin = 562.135
            xmax = 575.415
            text = "dan paling aku syukuri adalah alhamdulillah nian mimpiku dari dulu untuk pacak kerjo magang dan beraktivitas dari rumah tanpa perlu repot-repot makai kaos kaki akhirnyo beneran tercapai jugo sekarang"
        intervals [197]:
            xmin = 575.415
            xmax = 575.880
            text = ""
