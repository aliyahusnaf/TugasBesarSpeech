            text = ""
        intervals [2]:
            xmin = 0.120
            xmax = 9.480
            text = "nah sekarang aku nak pindah ke topik hobi sebenernya hobi aku dari kecik sampe sekarang aku dak terlalu banyak berubah dulu aku memang suko main game samo nonton film"
        intervals [3]:
            xmin = 9.480
            xmax = 10.100
            text = ""
        intervals [4]:
            xmin = 10.100
            xmax = 13.380
            text = "dua kegiatan itulah yang jadi hiburan aku dari jaman masih kecik"
        intervals [5]:
            xmin = 13.380
            xmax = 14.060
            text = ""
        intervals [6]:
            xmin = 14.060
            xmax = 19.000
            text = "kalo main game sebenernya aku serunya tu karno banyak jenis permainan yang bisa dicubo"
        intervals [7]:
            xmin = 19.000
            xmax = 19.740
            text = ""
        intervals [8]:
            xmin = 19.740
            xmax = 24.960
            text = "ada yang butuh strategi ada yang butuh kecepatan ada juga yang memang cuma buat hiburan bae"
        intervals [9]:
            xmin = 24.960
            xmax = 25.540
            text = ""
        intervals [10]:
            xmin = 25.540
            xmax = 28.620
            text = "jadi tergantung lagi pengen main yang cak mano lah"
        intervals [11]:
            xmin = 28.620
            xmax = 30.100
            text = ""
        intervals [12]:
            xmin = 30.100
            xmax = 35.640
            text = "nah apalagi sekarang ni aku kuliah di itb yang tugasnyo kadang banyak nian jadi kalu lagi ado waktu luang"
        intervals [13]:
            xmin = 35.640
            xmax = 36.540
            text = ""
        intervals [14]:
            xmin = 36.540
            xmax = 39.780
            text = "main game ni biso jadi salah satu caro buat istirahat dari kesibukan kuliah"
        intervals [15]:
            xmin = 39.780
            xmax = 40.420
            text = ""
        intervals [16]:
            xmin = 40.420
            xmax = 42.640
            text = "selain main game aku juga suko nonton film"
        intervals [17]:
            xmin = 42.640
            xmax = 43.360
            text = ""
        intervals [18]:
            xmin = 43.360
            xmax = 48.500
            text = "menurut aku nonton film ni menarik karno kita bisa menikmati berbagai macam cerito"
        intervals [19]:
            xmin = 48.500
            xmax = 49.080
            text = ""
        intervals [20]:
            xmin = 49.080
            xmax = 55.700
            text = "kadang ada film yang lucu ada yang bikin penasaran ada juga yang bikin mikir setelah selesai ditonton"
        intervals [21]:
            xmin = 55.700
            xmax = 56.480
            text = ""
        intervals [22]:
            xmin = 56.480
            xmax = 63.180
            text = "dan yang paling enak duo hobi ini dak perlu persiapan yang ribet kalo lagi ado waktu kosong tinggal main game atau cari film yang menarik buat ditonton aja lah"
        intervals [23]:
            xmin = 63.180
            xmax = 64.060
            text = ""
        intervals [24]:
            xmin = 64.060
            xmax = 69.700
            text = "nah tapi semenjak kuliah ada satu hobi yang jadi makin sering aku lakuin yaitu jalan-jalan"
        intervals [25]:
            xmin = 69.700
            xmax = 70.280
            text = ""
        intervals [26]:
            xmin = 70.280
            xmax = 74.860
            text = "sebenernyo aku dari dulu juga suko jalan-jalan tapi pas kuliah ini kesempatannya jadi jauh lebih banyak"
        intervals [27]:
            xmin = 74.860
            xmax = 75.540
            text = ""
        intervals [28]:
            xmin = 75.540
            xmax = 82.440
            text = "sebenernyo aku kan ngerantau dari bekasi ke bandung jadi otomatis bakal tempat baru banyak yang belum pernah aku datengi"
        intervals [29]:
            xmin = 82.440
            xmax = 82.940
            text = ""
        intervals [30]:
            xmin = 82.940
            xmax = 88.540
            text = "apolagi selama kuliah aku bawa motor jadi kalu nak pergi ke berbagai tempat aku lebih gampang karna ada kendaraan dewek"
        intervals [31]:
            xmin = 88.540
            xmax = 89.820
            text = ""
        intervals [32]:
            xmin = 89.820
            xmax = 94.040
            text = "dak selalu harus bergantung samo kendaraan umum atau mintak anter wong lain lah"
        intervals [33]:
            xmin = 94.040
            xmax = 95.620
            text = ""
        intervals [34]:
            xmin = 95.620
            xmax = 107.500
            text = "menurut aku ni bandung memang menarik buat dijelajahi banyak tempat yang bisa didatengi dan suasanannyo juga bedo sama bekasi jadi semenjak tinggal di sini aku lebih sering tertarik buat eksplor tempat-tempat baru"
        intervals [35]:
            xmin = 107.500
            xmax = 107.980
            text = ""
        intervals [36]:
            xmin = 107.980
            xmax = 112.220
            text = "nah dari beberapa pengalaman jalan-jalan aku ado duo perjalanan yang paling berkesan"
        intervals [37]:
            xmin = 112.220
            xmax = 112.800
            text = ""
        intervals [38]:
            xmin = 112.800
            xmax = 122.360
            text = "yang pertamo tu waktu aku pergi ke kepulauan seribu bareng kawan-kawan kami pergi selamo beberapa hari jadi bukan cuma sekedar datang sebentar lalu pulang"
        intervals [39]:
            xmin = 122.360
            xmax = 123.100
            text = ""
        intervals [40]:
            xmin = 123.100
            xmax = 129.320
            text = "menurut aku perjalanan tu seru nian karno bisa liburan bareng kawan-kawan dan menikmati suasana yang beda dari kehidupan sehari-hari"
        intervals [41]:
            xmin = 129.320
            xmax = 130.460
            text = ""
        intervals [42]:
            xmin = 130.460
            xmax = 142.280
            text = "terus perjalanan kedua yang paling aku inget tu waktu pergi ke batu karas juga bareng kawan-kawan nah perjalanan ini juga seru nian kami pergi selamo beberapa hari jadi cukup banyak waktu yang biso dinikmati bareng-bareng"
        intervals [43]:
            xmin = 142.280
            xmax = 143.000
            text = ""
        intervals [44]:
            xmin = 143.000
            xmax = 147.760
            text = "menurut aku yang bikin jalan-jalan bareng kawan tu menyenangkan bukan cuma tempat tujuannya"
        intervals [45]:
            xmin = 147.760
            xmax = 148.360
            text = ""
        intervals [46]:
            xmin = 148.360
            xmax = 157.080
            text = "tapi tapi juga suasana selama perjalanan kito biso ngobrol becando dan menghabiske waktu samo-samo tanpa harus mikirke tugas kuliah terus lah"
        intervals [47]:
            xmin = 157.080
            xmax = 158.420
            text = ""
        intervals [48]:
            xmin = 158.420
            xmax = 160.200
            text = "apalagi kalu lagi sibuk-sibuknyo kuliah"
        intervals [49]:
            xmin = 160.200
            xmax = 161.460
            text = ""
        intervals [50]:
            xmin = 161.460
            xmax = 169.380
            text = "kadang rasonyo butuh nian suasana baru jadi kalu ado kesempatan buat pergi beberapa hari menurut aku itu biso jadi caro buat nyegarke pikiran"
        intervals [51]:
