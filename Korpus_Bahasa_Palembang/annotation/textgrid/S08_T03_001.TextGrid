            text = "karna ngejar tenggat tugas besak"
        intervals [185]:
            xmin = 408.775
            xmax = 409.795
            text = ""
        intervals [186]:
            xmin = 409.795
            xmax = 412.675
            text = "terus paginyo langsung kuliah lagi kacau"
        intervals [187]:
            xmin = 412.675
            xmax = 413.215
            text = ""
        intervals [188]:
            xmin = 413.215
            xmax = 417.555
            text = "situ aku baru ngerti ngapo kakak aku dulu udah sering sering dak tidur"
        intervals [189]:
            xmin = 417.555
            xmax = 418.535
            text = ""
        intervals [190]:
            xmin = 418.535
            xmax = 427.095
            text = "tapi dari situ juga aku belajar banyak nian selain kuliah aku juga aktif jadi asisten praktikum jadi aku pacak bantu adek-adek tingkat yang lagi belajar"
        intervals [191]:
            xmin = 427.095
            xmax = 427.675
            text = ""
        intervals [192]:
            xmin = 427.675
            xmax = 431.735
            text = "ternyata ngajar wong lain tu seru nian dan aku jadi paham materinyo dewek"
        intervals [193]:
            xmin = 431.735
            xmax = 432.495
            text = ""
        intervals [194]:
            xmin = 432.495
            xmax = 436.935
            text = "aku juga ikut di inkubator it tempat mahasiswa ngerjoke"
        intervals [195]:
            xmin = 436.935
            xmax = 437.575
            text = ""
        intervals [196]:
            xmin = 437.575
            xmax = 439.275
            text = "proyek aplikasi beneran untuk klien"
        intervals [197]:
            xmin = 439.275
            xmax = 440.015
            text = ""
        intervals [198]:
            xmin = 440.015
            xmax = 448.935
            text = "di sana aku belajar kalu bikin aplikasi tu dak cuma soal ngoding bae tapi juga soal ngomong samo klien ngatur waktu dan kerjo samo tim"
        intervals [199]:
            xmin = 448.935
            xmax = 449.890
            text = ""
        intervals [200]:
            xmin = 449.890
            xmax = 455.490
            text = "terus kemaren aku jugo sempet magang jadi aku ngeraso langsung cak mano dunia kerja yang sebenernyo"
        intervals [201]:
            xmin = 455.490
            xmax = 456.450
            text = ""
        intervals [202]:
            xmin = 456.450
            xmax = 460.910
            text = "galo pengalaman ini buat aku makin yakin kalu aku memang dak salah pilih jurusan"
        intervals [203]:
            xmin = 460.910
            xmax = 461.730
            text = ""
        intervals [204]:
            xmin = 461.730
            xmax = 468.770
            text = "sekarang aku lagi nyiapke tugas akhir jadi dak lamo lagi kalau lancar aku pacak lulus"
        intervals [205]:
            xmin = 468.770
            xmax = 469.350
            text = ""
        intervals [206]:
            xmin = 469.350
            xmax = 470.210
            text = "doake bae yo"
        intervals [207]:
            xmin = 470.210
            xmax = 471.010
            text = ""
        intervals [208]:
            xmin = 471.010
            xmax = 471.230
            text = "nah"
        intervals [209]:
            xmin = 471.230
            xmax = 471.830
            text = ""
        intervals [210]:
            xmin = 471.830
            xmax = 478.230
            text = "kalu harapan aku dari jurusan yang sekarang aku galak pacak belajar nian soal teknologi jaman ini"
        intervals [211]:
            xmin = 478.230
            xmax = 479.230
            text = ""
        intervals [212]:
            xmin = 479.230
            xmax = 482.450
            text = "apolagi kecerdasan buatan yang berkembang cepet nian"
        intervals [213]:
            xmin = 482.450
            xmax = 483.430
            text = ""
        intervals [214]:
            xmin = 483.430
            xmax = 488.630
            text = "sekarang ni banyak hal yang dulu dikerjoke wong lah pacak dikerjoke ai sekarang"
        intervals [215]:
            xmin = 488.630
            xmax = 489.310
            text = ""
        intervals [216]:
            xmin = 489.310
            xmax = 494.550
            text = "jadi aku dak galak ketinggalan aku galak terus belajar biar ilmu aku dak basi"
        intervals [217]:
            xmin = 494.550
            xmax = 495.650
            text = ""
        intervals [218]:
            xmin = 495.650
            xmax = 499.170
            text = "aku jugo galak dapet ilmu yang memang berguna nian di dunia kerjo"
        intervals [219]:
            xmin = 499.170
            xmax = 499.750
            text = ""
        intervals [220]:
            xmin = 499.750
            xmax = 501.050
            text = "dak cuma teori bae"
        intervals [221]:
            xmin = 501.050
            xmax = 501.590
            text = ""
        intervals [222]:
            xmin = 501.590
            xmax = 502.810
            text = "terus aku galak"
        intervals [223]:
            xmin = 502.810
            xmax = 503.610
            text = ""
        intervals [224]:
            xmin = 503.610
            xmax = 508.070
            text = "pacak bikin aplikasi atau sistem yang bermanfaat untuk wong banyak"
        intervals [225]:
            xmin = 508.070
            xmax = 508.770
            text = ""
        intervals [226]:
            xmin = 508.770
            xmax = 511.990
            text = "biar ilmu yang aku dapet ni dak cuma untuk aku dewek"
        intervals [227]:
            xmin = 511.990
            xmax = 512.690
            text = ""
        intervals [228]:
            xmin = 512.690
            xmax = 517.910
            text = "misalnyo aplikasi yang bisa ngebantu wong di daerah yang susah dapet layanan"
        intervals [229]:
            xmin = 517.910
            xmax = 518.650
            text = ""
        intervals [230]:
            xmin = 518.650
            xmax = 521.870
            text = "atau sistem yang bisa buat kerjoan wong jadi lebih gampang"
        intervals [231]:
            xmin = 521.870
            xmax = 523.150
            text = ""
        intervals [232]:
            xmin = 523.150
            xmax = 526.710
            text = "selain itu aku jugo berharap pacak sukses"
        intervals [233]:
            xmin = 526.710
            xmax = 527.270
            text = ""
        intervals [234]:
            xmin = 527.270
            xmax = 528.090
            text = "cak kakakku"
        intervals [235]:
            xmin = 528.090
            xmax = 528.950
            text = ""
        intervals [236]:
            xmin = 528.950
            xmax = 531.210
            text = "pacak bahagiake mamak samo bapak"
        intervals [237]:
            xmin = 531.210
            xmax = 532.035
            text = ""
        intervals [238]:
            xmin = 532.035
            xmax = 534.335
            text = "yang lah banyak nian berkorban untuk aku"
        intervals [239]:
            xmin = 534.335
            xmax = 535.035
            text = ""
        intervals [240]:
            xmin = 535.035
            xmax = 537.055
            text = "dan kalau aku udah sukses gek"
        intervals [241]:
            xmin = 537.055
            xmax = 537.675
            text = ""
        intervals [242]:
            xmin = 537.675
            xmax = 542.035
            text = "aku galak pacak bantu adek-adek tingkat yang nak ngelewati jalan yang samo"
        intervals [243]:
            xmin = 542.035
            xmax = 542.555
            text = ""
        intervals [244]:
            xmin = 542.555
            xmax = 544.395
            text = "cak mano dulu kakak aku bantu aku"
        intervals [245]:
            xmin = 544.395
            xmax = 545.000
            text = ""
