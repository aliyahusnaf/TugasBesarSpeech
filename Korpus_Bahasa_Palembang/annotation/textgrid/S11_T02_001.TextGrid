item []:
    item [1]:
        class = "IntervalTier"
        name = "utterance"
        xmin = 0
        xmax = 70.000
        intervals: size = 22
        intervals [1]:
            xmin = 0.000
            xmax = 5.300
            text = "kalu ngomongin soal kegemaran dari dulu aku memang tertarik samo hal-hal yang berhubungan dengan teknologi"
        intervals [2]:
            xmin = 5.300
            xmax = 5.900
            text = ""
        intervals [3]:
            xmin = 5.900
            xmax = 13.520
            text = "aku seneng ngotak-ngatik komputer nyobo aplikasi baru dan penasaran samo gimano sebuah website atau aplikasi pacak dibuat"
        intervals [4]:
            xmin = 13.520
            xmax = 14.120
            text = ""
        intervals [5]:
            xmin = 14.120
            xmax = 17.480
            text = "apolagi kalu nemu website yang tampilannyo bagus nian"
        intervals [6]:
            xmin = 17.480
            xmax = 18.000
            text = ""
        intervals [7]:
            xmin = 18.000
            xmax = 22.040
            text = "kadang aku malah lebih sibuk merhatike desainnyo daripada isi website itu dewek"
        intervals [8]:
            xmin = 22.040
            xmax = 22.820
            text = ""
        intervals [9]:
            xmin = 22.820
            xmax = 26.080
            text = "aku suka mikir cak mano caronyo wong pacak"
        intervals [10]:
            xmin = 26.080
            xmax = 26.700
            text = ""
        intervals [11]:
            xmin = 26.700
            xmax = 28.000
            text = "bikin tampilan yang menarik"
        intervals [12]:
            xmin = 28.000
            xmax = 28.580
            text = ""
        intervals [13]:
            xmin = 28.580
            xmax = 42.880
            text = "tapi tetap gampang digunakan dari situ aku mulai tertarik samo dunia pemrograman dan desain aplikasi menurut aku ado kepuasan tersendiri waktu sesuatu yang awalnyo cuma ado di pikiran akhirnyo pacak diwujudke"
        intervals [14]:
            xmin = 42.880
            xmax = 43.460
            text = ""
        intervals [15]:
            xmin = 43.460
            xmax = 45.520
            text = "jadi aplikasi yang beneran berjalan"
        intervals [16]:
            xmin = 45.520
            xmax = 46.340
            text = ""
        intervals [17]:
            xmin = 46.340
            xmax = 50.740
            text = "selain teknologi aku jugo seneng kegiatan yang melibatkan banyak wong"
        intervals [18]:
            xmin = 50.740
            xmax = 51.220
            text = ""
        intervals [19]:
            xmin = 51.220
            xmax = 64.500
            text = "aku suka berdiskusi bertukar pikiran dan bekerjo samo dalam tim menurut aku ngobrol samo wong yang punyo sudut pandang berbeda tu menarik nian karno kito pacak dapet ide baru yang sebelumnyo dak kepikiran"
        intervals [20]:
            xmin = 64.500
            xmax = 65.080
            text = ""
        intervals [21]:
            xmin = 65.080
            xmax = 69.540
            text = "mungkin dari kegemaran-kegemaran itulah aku akhirnyo tertarik masuk ke dunia informatika"
        intervals [22]:
            xmin = 69.540
            xmax = 70.000
            text = ""
