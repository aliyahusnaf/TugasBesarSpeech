        intervals [8]:
            xmin = 9.255
            xmax = 21.175
            text = "yang pertamo aku suko olahraga terutama latihan di gym buat aku olahraga tu bukan cuma soal nak bentuk badan atau nak keliatan lebih fit bae tapi juga soal melatih kedisiplinan diri"
