        intervals [10]:
            xmin = 21.835
            xmax = 28.935
            text = "aku biaso nyempetin waktu beberapa kali seminggu untuk latihan kadang-kadang kalo lagi banyak tugas kuliah atau ado proyek yang kudu diselesaike"
        intervals [11]:
