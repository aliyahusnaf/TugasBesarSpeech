        intervals: size = 100
        intervals [1]:
            xmin = 0.000
            xmax = 2.700
            text = "sekarang tu aku nak cerito tentang soal kuliah aku"
        intervals [2]:
            xmin = 2.700
            xmax = 3.520
            text = ""
        intervals [3]:
            xmin = 3.520
            xmax = 5.740
            text = "sekarang aku kuliah di itb"
        intervals [4]:
            xmin = 5.740
            xmax = 6.400
            text = ""
        intervals [5]:
            xmin = 6.400
            xmax = 7.760
            text = "jurusan teknik informatika"
        intervals [6]:
            xmin = 7.760
            xmax = 8.380
            text = ""
        intervals [7]:
            xmin = 8.380
            xmax = 15.620
            text = "dan ngapo aku milih itb salah satu alasan pertamanya karno itb itu dikenal sebagai salah satu perguruan tinggi yang bagus di indonesia"
        intervals [8]:
            xmin = 15.620
            xmax = 16.300
            text = ""
        intervals [9]:
            xmin = 16.300
            xmax = 26.900
            text = "aku ngeraso lingkungan kuliah tu penting nian karno di kampus kito dak cuma belajar materi dari dosen tapi jugo ketemu banyak wong dengan minat kemampuan dan pengalaman yang beda-beda"
        intervals [10]:
            xmin = 26.900
            xmax = 27.900
            text = ""
        intervals [11]:
            xmin = 27.900
            xmax = 33.420
            text = "dari situ jugo kita biso saling belajar tukar pikiran bahkan bikin proyek proyek samo-samo"
        intervals [12]:
            xmin = 33.420
            xmax = 34.040
            text = ""
        intervals [13]:
            xmin = 34.040
            xmax = 39.460
            text = "menurutku lingkungan yang mendukung cak ini tuh bisa bantu aku berkembang"
        intervals [14]:
            xmin = 39.460
            xmax = 40.000
            text = ""
        intervals [15]:
            xmin = 40.000
            xmax = 42.660
            text = "bukan cuma secara akademik tapi juga secara pribadi"
        intervals [16]:
            xmin = 42.660
            xmax = 43.520
            text = ""
        intervals [17]:
            xmin = 43.520
            xmax = 50.180
            text = "selain itu aku juga tertarik dengan perkembangan teknologi jadi kuliah di kampus yang punya lingkungan pendidikan teknik yang kuat"
        intervals [18]:
            xmin = 50.180
            xmax = 50.800
            text = ""
        intervals [19]:
            xmin = 50.800
            xmax = 53.760
            text = "menjadi salah satu hal yang buat aku tertarik masuk itb"
        intervals [20]:
            xmin = 53.760
            xmax = 54.540
            text = ""
        intervals [21]:
            xmin = 54.540
            xmax = 56.680
            text = "terus ngapo aku pilih teknik informatika"
        intervals [22]:
            xmin = 56.680
            xmax = 58.120
            text = ""
        intervals [23]:
            xmin = 58.120
            xmax = 64.620
            text = "dari aku mulai belajar teknologi lebih jauh aku tertarik dengan proses di balik aplikasi dan sistem yang kito pake hari-hari"
        intervals [24]:
            xmin = 64.620
            xmax = 65.200
            text = ""
        intervals [25]:
            xmin = 65.200
            xmax = 74.860
            text = "kito mungkin cuma tinggal mencet nomor hp tapi di balik itu ado banyak hal yang bekerja mulai dari pemrograman pengolahan data sampe algoritma yang ngatur caro suatu sistem itu mengambil keputusan"
        intervals [26]:
            xmin = 74.860
            xmax = 75.820
            text = ""
        intervals [27]:
            xmin = 75.820
            xmax = 82.585
            text = "aku ngeraso teknik informatika nih cocok karno jurusan ini menggabungkan logika pemecahan masalah dan kreativitas"
        intervals [28]:
            xmin = 82.585
            xmax = 83.205
            text = ""
        intervals [29]:
            xmin = 83.205
            xmax = 87.145
            text = "kito dak cuma belajar teori tapi jugo ditantang untuk merancang dan membangun sesuatu"
        intervals [30]:
            xmin = 87.145
            xmax = 88.085
            text = ""
        intervals [31]:
            xmin = 88.085
            xmax = 94.725
            text = "apolagi sekarang perkembangan ai cepet nian lah banyak hal yang sebelumnya terasa sulit atau bahkan dak mungkin sekarang"
        intervals [32]:
            xmin = 94.725
            xmax = 95.325
            text = ""
        intervals [33]:
            xmin = 95.325
            xmax = 102.245
            text = "mulai bisa dilakuin dengan bantuan teknologi aku jadi makin tertarik untuk mempelajari caro kerja ai dan caro mengembangkannya supaya"
        intervals [34]:
            xmin = 102.245
            xmax = 103.005
            text = ""
        intervals [35]:
            xmin = 103.005
            xmax = 105.165
            text = "biso dipake untuk menyelesaike masalah nyata"
        intervals [36]:
            xmin = 105.165
            xmax = 106.025
            text = ""
        intervals [37]:
            xmin = 106.025
            xmax = 115.045
            text = "tentu bae kuliah teknik informatika dak semudah yang mungkin dibayangkan wong kadang tugasnyo banyak materinyo sulit dan kito kudu belajar konsep yang awalnyo dak langsung paham"
        intervals [38]:
            xmin = 115.045
            xmax = 115.585
            text = ""
        intervals [39]:
            xmin = 115.585
            xmax = 121.005
            text = "tapi justru dari situ aku belajar untuk lebih sabar lebih teliti dan lebih berani nyubo hal baru"
        intervals [40]:
            xmin = 121.005
            xmax = 121.745
            text = ""
        intervals [41]:
            xmin = 121.745
            xmax = 126.665
            text = "kalo misalnyo dulu aku dak masuk teknik informatika ada tiga jurusan lain yang mungkin aku bakal aku pertimbangkan"
        intervals [42]:
            xmin = 126.665
            xmax = 127.325
            text = ""
        intervals [43]:
            xmin = 127.325
            xmax = 127.985
            text = "yang pertama"
        intervals [44]:
            xmin = 127.985
            xmax = 128.545
            text = ""
        intervals [45]:
            xmin = 128.545
            xmax = 134.965
            text = "sistem dan teknologi informasi menurut aku jurusan ini tuh menarik karno menggabungkan teknologi dengan kebutuhan suatu organisasi atau perusahaan"
        intervals [46]:
            xmin = 134.965
            xmax = 135.645
            text = ""
        intervals [47]:
            xmin = 135.645
            xmax = 138.925
            text = "jadi kito dak cuma mikir soal gimano cara bikin sistem tapi juga"
        intervals [48]:
            xmin = 138.925
            xmax = 139.845
            text = ""
        intervals [49]:
            xmin = 139.845
            xmax = 144.385
            text = "soal masalah apo yang nak diselesaike dan gimano teknologi tu biso bantu menyelesaikannya"
        intervals [50]:
            xmin = 144.385
            xmax = 145.865
            text = ""
        intervals [51]:
            xmin = 145.865
            xmax = 153.205
            text = "aku tertarik dengan hal itu karno menurut aku teknologi yang bagus bukan sekadar teknologi yang canggih tapi juga teknologi yang memang dibutuhke dan"
        intervals [52]:
            xmin = 153.205
            xmax = 153.945
            text = ""
        intervals [53]:
            xmin = 153.945
            xmax = 161.205
            text = "biso dipake dengan baik kalu mau masuk jurusan ini aku berharap bisa belajar merancang solusi teknologi yang sesuai dengan kebutuhan pengguna"
        intervals [54]:
            xmin = 161.205
            xmax = 162.100
            text = ""
        intervals [55]:
            xmin = 162.100
            xmax = 167.900
            text = "yang keduo teknik elektro jurusan ini juga menarik buat aku karno berhubungan dengan teknologi dari sisi perangkat keras"
        intervals [56]:
